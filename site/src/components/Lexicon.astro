---
// The Lexicon of motion: a grid of every term, and the deck, its detail
// view. The deck is a stack of cards, a title card for each chapter and
// then its terms; scrolling pulls the top card out the way a kamishibai
// card is pulled. Every card has a permalink, /lexicon/<id>/, which is this
// same page with the deck open at that card.
import { CHAPTERS, TERMS, buildDeck } from "../lib/terms.ts";
import Frame from "./Frame.astro";

interface Props {
  /** open the deck at this card (a term id or a chapter id) on load */
  initial?: string;
}
const { initial } = Astro.props;
const base = import.meta.env.BASE_URL;
const deck = buildDeck();
const start = initial ? deck.findIndex((c) => c.id === initial) : -1;
const permalink = (id: string) => `${base}lexicon/${id}/`;
const host = new URL(base, Astro.site).host + base;
---
<div class="lexicon" data-base={base} data-start={start}>
  <header class="top">
    <div class="crumbs">
      <a class="logo" href={base}>kamishibai</a>
      <span>/ Lexicon</span>
    </div>
    <nav class="site-nav">
      <a href="https://github.com/reearth/kamishibai/blob/main/docs/README.md">Docs</a>
      <a href="https://github.com/reearth/kamishibai">GitHub</a>
    </nav>
  </header>

  <section class="intro">
    <span class="kicker">映像の語彙 · {TERMS.length} terms</span>
    <h1 class="h1">A lexicon<br />of motion.</h1>
    <p class="lead">Camera moves, motion, transitions and light. Each term has its name, a loop, and words you can hand to an agent. Every loop is a kamishibai reel, drawn from its time alone.</p>
    <div class="filters">
      <div class="chips" role="group" aria-label="Category">
        <button type="button" class="chip" data-cat="All" aria-pressed="true">All</button>
        {CHAPTERS.map((c) => <button type="button" class="chip" data-cat={c.cat} aria-pressed="false">{c.cat}</button>)}
      </div>
      <a class="chip accent" href={permalink(deck[0]!.id)} data-open="0">Watch them all as a deck</a>
    </div>
  </section>

  <section class="grid">
    {TERMS.map((t) => (
      <a class="card" href={permalink(t.id)} data-open={deck.findIndex((c) => c.id === t.id)} data-cat={t.cat}>
        <Frame id={t.id} dark={t.dark} />
        <span class="name"><b>{t.en}</b><span>{t.ja}</span></span>
        <span class="desc">{t.desc}</span>
        <span class="cat">{t.cat}</span>
      </a>
    ))}
  </section>

  <div class="deck" role="dialog" aria-modal="true" aria-label="Lexicon deck" hidden={start < 0}>
    <div class="scroller">
      <div class="deck-stage">
        <header class="deck-top">
          <a class="btn ghost back" href={`${base}lexicon/`} data-close>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
            All terms
          </a>
          <div class="link">
            <span class="mono url" data-url>{host}lexicon/{start >= 0 ? deck[start]!.id : deck[0]!.id}/</span>
            <button type="button" class="btn" data-copy-link>Copy link</button>
          </div>
        </header>

        <div class="deck-body">
          <div class="pile">
            <div class="holder">
              <button type="button" class="nav prev" data-prev aria-label="Previous card">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M11 3L5 9l6 6"></path></svg>
              </button>
              <button type="button" class="nav next" data-next aria-label="Pull the next card">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3l6 6-6 6"></path></svg>
              </button>
              {deck.map((c, i) => (
                <article class="dcard" data-i={i} data-id={c.id} data-title={c.kind === "term" ? c.en : c.cat} hidden={i !== Math.max(0, start) && i !== Math.max(0, start) + 1}>
                  {c.kind === "chapter" ? (
                    <div class="chapter">
                      <span class="kicker">Chapter {c.chapter}</span>
                      <div><span class="big">{c.cat}</span><span class="sub">{c.ja} · {c.count} terms</span></div>
                      <span class="bar"></span>
                    </div>
                  ) : (
                    <Frame id={c.id} dark={c.dark} />
                  )}
                </article>
              ))}
            </div>
          </div>

          <div class="scripts">
            {deck.map((c, i) => (
              <aside class="script" data-i={i} aria-label="Script" hidden={i !== Math.max(0, start)}>
                <div class="head"><span class="kicker">台本 · Script</span><span class="mono">{c.kind === "term" ? `${String(c.no).padStart(2, "0")} / ${TERMS.length}` : `Chapter ${c.chapter}`}</span></div>
                <div><h2>{c.kind === "term" ? c.en : c.cat}</h2><span class="ja">{c.ja}</span></div>
                {c.kind === "term" ? (
                  <>
                    <p>{c.desc}</p>
                    <div class="ask">
                      <span>Ask for it</span>
                      <p>{c.ask}</p>
                      <button type="button" class="btn solid" data-copy-ask={c.ask}>Copy</button>
                    </div>
                  </>
                ) : (
                  <p>{c.count} terms in this chapter. Scroll, or pull the next card, to go through them.</p>
                )}
                <span class="note">In kamishibai, the performer reads the lines for a picture from the back of the card before it. Here they sit beside the picture.</span>
              </aside>
            ))}
          </div>
        </div>

        <div class="deck-foot">
          <span class="mono">scroll = seek(<span data-scroll-ms>0ms</span>)</span>
          <div class="thumbs" role="list" aria-label="All cards">
            {deck.map((c, i) => (
              <a role="listitem" class={`thumb${c.kind === "chapter" ? " chapter" : ""}`} href={permalink(c.id)} data-go={i} aria-label={c.kind === "term" ? c.en : `Chapter ${c.chapter}: ${c.cat}`}></a>
            ))}
          </div>
        </div>
      </div>
      <div class="runway" style={`height: ${(deck.length - 1) * 100}svh`}></div>
    </div>
  </div>
</div>

<style>
  .lexicon { min-height: 100vh; }
  .top, .intro, .grid { max-width: 1320px; margin: 0 auto; padding-left: clamp(16px, 4vw, 40px); padding-right: clamp(16px, 4vw, 40px); }
  .top { padding-top: 28px; padding-bottom: 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .crumbs { display: flex; align-items: baseline; gap: 12px; font-size: 15px; color: var(--ink-3); }
  .logo { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
  .intro { padding-top: 40px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 18px; }
  .kicker { font-size: 15px; font-weight: 500; color: var(--kaki-text); }
  .h1 { margin: 0; font-size: clamp(40px, 6.4vw, 88px); line-height: 0.98; font-weight: 800; letter-spacing: -0.05em; }
  .lead { margin: 0; max-width: 620px; font-size: 18px; line-height: 1.6; color: var(--ink-2); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; align-items: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { appearance: none; background: transparent; border: 1px solid var(--ink); padding: 10px 14px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .chip.accent { margin-left: auto; border-color: var(--kaki-text); color: var(--kaki-text); }
  .grid { padding-top: 8px; padding-bottom: 120px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }
  .card { display: flex; flex-direction: column; gap: 12px; background: var(--paper); padding: 14px 14px 18px; text-decoration: none; color: var(--ink); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06); transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s; }
  .card:hover { color: var(--ink); transform: translateY(-3px) rotate(-0.4deg); box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14); }
  .card[hidden] { display: none; }
  .name { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .name b { font-size: 18px; letter-spacing: -0.02em; }
  .name span { font-size: 13px; color: var(--ink-3); }
  .desc { font-size: 14px; line-height: 1.5; color: var(--ink-2); }
  .cat { font-size: 12px; font-weight: 500; color: var(--kaki-text); }

  .deck { position: fixed; inset: 0; z-index: 20; background: var(--desk); }
  .deck[hidden] { display: none; }
  .scroller { height: 100%; overflow-y: auto; overscroll-behavior: contain; }
  .deck-stage { position: sticky; top: 0; height: 100svh; min-height: 560px; overflow: hidden; display: flex; flex-direction: column; padding: 20px clamp(16px, 3vw, 40px); }
  .deck-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 4px 0 16px; }
  .back { padding-left: 0; }
  .link { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .url { font-size: 13px; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .deck-body { flex: 1; min-height: 0; display: flex; gap: clamp(20px, 3vw, 48px); }
  .pile { flex: 1 1 auto; min-width: 0; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .holder { position: relative; height: min(100%, calc((100vw - 560px) * 0.75)); min-height: 200px; aspect-ratio: 4 / 3; max-width: calc(100% - 96px); }
  .dcard { position: absolute; inset: 0; background: var(--paper); padding: 4%; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06); will-change: transform; }
  .dcard[hidden] { display: none; }
  .dcard :global(.frame) { height: 100%; aspect-ratio: auto; }
  .chapter { height: 100%; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--ink); padding: 7%; }
  .chapter .big { display: block; font-size: clamp(40px, 6vw, 88px); line-height: 0.95; font-weight: 800; letter-spacing: -0.05em; }
  .chapter .sub { display: block; margin-top: 10px; font-size: 20px; color: var(--ink-2); }
  .chapter .bar { height: 6px; width: 30%; background: var(--kaki); }
  .nav { position: absolute; top: 50%; width: 44px; height: 44px; margin-top: -22px; display: flex; align-items: center; justify-content: center; background: transparent; border: 0; cursor: pointer; z-index: 5; }
  .nav.prev { left: -56px; }
  .nav.next { right: -56px; }
  .nav:disabled { opacity: 0.25; cursor: default; }
  .scripts { width: 380px; flex: none; display: flex; min-height: 0; }
  .script { flex: 1; background: var(--paper); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06); padding: clamp(20px, 2.4vw, 32px); display: flex; flex-direction: column; gap: 16px; overflow-y: auto; }
  .script[hidden] { display: none; }
  .script .head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 13px; color: var(--ink-3); }
  .script h2 { margin: 0; font-size: clamp(28px, 2.8vw, 40px); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; }
  .script .ja { display: block; margin-top: 6px; font-size: 17px; color: var(--ink-3); }
  .script p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--ink-2); }
  .ask { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; background: var(--well); padding: 16px; border: 1px solid var(--rule); }
  .ask > span { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .ask p { color: var(--ink); font-size: 15px; line-height: 1.6; }
  .note { margin-top: auto; font-size: 13px; line-height: 1.55; color: var(--ink-3); }
  .deck-foot { display: flex; align-items: center; gap: 14px; padding-top: 16px; font-size: 13px; color: var(--ink-2); }
  .deck-foot > span { white-space: nowrap; }
  .thumbs { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: 4px; }
  .thumb { display: block; aspect-ratio: 4 / 3; background: var(--paper); outline: 1px solid var(--rule); }
  .thumb.chapter { background: var(--kaki); }
  .thumb.now { outline: 2px solid var(--ink); }

  @media (max-width: 900px) {
    .deck-body { flex-direction: column; }
    .scripts { width: auto; flex: 1 1 auto; }
    .note, .url, .thumbs { display: none; }
    .holder { height: auto; width: calc(100% - 96px); max-width: none; }
  }
</style>

<script>
  import { DRAW } from "../lib/draw.ts";
  import { LOOP_MS } from "../lib/terms.ts";
  import { paint, reel } from "../lib/reel.ts";

  // Read before anything rewrites the address (opening the deck does).
  const single = new URLSearchParams(location.search).has("card");
  const root = document.querySelector<HTMLElement>(".lexicon")!;
  const base = root.dataset.base!;
  const deckEl = root.querySelector<HTMLElement>(".deck")!;
  const scroller = deckEl.querySelector<HTMLElement>(".scroller")!;
  const cards = [...deckEl.querySelectorAll<HTMLElement>(".dcard")];
  const scripts = [...deckEl.querySelectorAll<HTMLElement>(".script")];
  const thumbs = [...deckEl.querySelectorAll<HTMLElement>("[data-go]")];
  const urlEl = deckEl.querySelector<HTMLElement>("[data-url]")!;
  const scrollMs = deckEl.querySelector<HTMLElement>("[data-scroll-ms]")!;
  const prevBtn = deckEl.querySelector<HTMLButtonElement>("[data-prev]")!;
  const nextBtn = deckEl.querySelector<HTMLButtonElement>("[data-next]")!;
  const N = cards.length;
  const host = `${location.host}${base}`;
  const gridTitle = document.title;

  const clamp = (v: number) => Math.max(0, Math.min(1, v));
  const smooth = (p: number) => p * p * (3 - 2 * p);
  const idAt = (i: number) => cards[i]!.dataset.id!;
  const pathOf = (i: number) => `${base}lexicon/${idAt(i)}/`;

  // ---- grid filters ----
  const chips = [...root.querySelectorAll<HTMLButtonElement>(".chip[data-cat]")];
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const cat = chip.dataset.cat!;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      root.querySelectorAll<HTMLElement>(".card").forEach((card) => (card.hidden = cat !== "All" && card.dataset.cat !== cat));
    }),
  );

  // ---- the deck ----
  let shown = -1;
  function frame(): void {
    const h = Math.max(1, scroller.clientHeight);
    const s = Math.min(N - 1, scroller.scrollTop / h);
    const idx = Math.floor(s);
    // Each card rests, then is pulled out over the middle of its screen of
    // scroll, far enough to leave the screen.
    const q = smooth(clamp((s - idx - 0.12) / 0.76));
    cards.forEach((el, i) => {
      const live = i === idx || i === idx + 1;
      el.hidden = !live;
      el.style.zIndex = i === idx ? "2" : "1";
      el.style.transform = i === idx && q > 0 ? `translateX(calc(${(-q * 100).toFixed(2)}% - ${(q * 60).toFixed(2)}vw)) rotate(${(-q * 2).toFixed(3)}deg)` : "";
      el.style.boxShadow = i === idx && q > 0 && q < 1 ? `0 ${(2 + q * 28).toFixed(0)}px ${(6 + q * 56).toFixed(0)}px rgba(0,0,0,.22)` : "";
    });
    // The script and the address follow the card the audience mostly sees.
    const now = q < 0.5 ? idx : Math.min(N - 1, idx + 1);
    if (now !== shown) {
      shown = now;
      scripts.forEach((el, i) => (el.hidden = i !== now));
      thumbs.forEach((el, i) => el.classList.toggle("now", i === now));
      urlEl.textContent = `${host}lexicon/${idAt(now)}/`;
      document.title = `${cards[now]!.dataset.title} — Lexicon of motion`;
      if (!deckEl.hidden) history.replaceState({ deck: now }, "", pathOf(now));
      prevBtn.disabled = now <= 0;
      nextBtn.disabled = now >= N - 1;
    }
    scrollMs.textContent = `${Math.round(s * 1000)}ms`;
  }

  function go(i: number, smoothly = true): void {
    const top = Math.max(0, Math.min(N - 1, i)) * scroller.clientHeight;
    scroller.scrollTo({ top, behavior: smoothly ? "smooth" : "auto" });
  }

  function open(i: number, push = true): void {
    deckEl.hidden = false;
    document.documentElement.style.overflow = "hidden";
    shown = -1;
    go(i, false);
    frame();
    if (push) history.pushState({ deck: i }, "", pathOf(i));
  }

  function close(push = true): void {
    deckEl.hidden = true;
    document.documentElement.style.overflow = "";
    document.title = gridTitle;
    if (push) history.pushState({}, "", `${base}lexicon/`);
  }

  root.querySelectorAll<HTMLAnchorElement>("[data-open]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      open(Number(a.dataset.open));
    }),
  );
  thumbs.forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      go(Number(a.dataset.go));
    }),
  );
  deckEl.querySelector("[data-close]")!.addEventListener("click", (e) => {
    e.preventDefault();
    close();
  });
  prevBtn.addEventListener("click", () => go(shown - 1));
  nextBtn.addEventListener("click", () => go(shown + 1));
  addEventListener("keydown", (e) => {
    if (deckEl.hidden) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowRight") go(shown + 1);
    else if (e.key === "ArrowLeft") go(shown - 1);
  });

  const copy = (btn: HTMLButtonElement, text: string, label: string) => {
    void navigator.clipboard?.writeText(text).then(() => {
      const was = btn.textContent;
      btn.textContent = label;
      setTimeout(() => (btn.textContent = was), 1800);
    });
  };
  deckEl.querySelector<HTMLButtonElement>("[data-copy-link]")!.addEventListener("click", (e) =>
    copy(e.currentTarget as HTMLButtonElement, `${location.origin}${pathOf(shown)}`, "Link copied"),
  );
  deckEl.querySelectorAll<HTMLButtonElement>("[data-copy-ask]").forEach((b) =>
    b.addEventListener("click", () => copy(b, b.dataset.copyAsk!, "Copied")),
  );

  let queued = false;
  scroller.addEventListener("scroll", () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      frame();
    });
  }, { passive: true });
  addEventListener("resize", () => !deckEl.hidden && frame());

  addEventListener("popstate", () => {
    const m = location.pathname.slice(base.length).match(/^lexicon\/([a-z0-9-]+)\/$/);
    const i = m ? cards.findIndex((c) => c.dataset.id === m[1]) : -1;
    if (i >= 0) open(i, false);
    else close(false);
  });

  // A permalink page opens with the deck at its card.
  const start = Number(root.dataset.start);
  if (start >= 0) open(start, false);

  // ---- drawing: one clock for every loop on the page ----
  // Grid frames are drawn while they're on screen; deck frames while their
  // card is one of the two in play.
  const onScreen = new Set<HTMLElement>();
  const io = new IntersectionObserver((entries) =>
    entries.forEach((e) => (e.isIntersecting ? onScreen.add(e.target as HTMLElement) : onScreen.delete(e.target as HTMLElement))),
  );
  root.querySelectorAll<HTMLElement>(".grid [data-term]").forEach((f) => io.observe(f));
  function drawLoops(ms: number): void {
    const t = (ms % LOOP_MS) / LOOP_MS;
    const frames = deckEl.hidden ? [...onScreen] : cards.filter((c) => !c.hidden).map((c) => c.querySelector<HTMLElement>("[data-term]")).filter((f): f is HTMLElement => !!f);
    for (const f of frames) paint(f, DRAW[f.dataset.term!]!(t));
  }

  // As a reel, the page walks the deck from its first card (or a permalink's
  // card) to the last: one loop's length on each card, the last part of it
  // spent pulling the card out. With ?card, it is just that card's loop.
  const from = Math.max(0, start);
  const PULL_MS = 800;
  reel(
    { fps: 30, durationMs: single ? LOOP_MS : (N - from) * LOOP_MS, width: 1280, height: 800 },
    (ms, driven) => {
      if (driven) {
        if (deckEl.hidden) open(from, false);
        if (!single) {
          const k = Math.min(N - 1, from + Math.floor(ms / LOOP_MS));
          const local = ms - (k - from) * LOOP_MS;
          const p = k < N - 1 ? clamp((local - (LOOP_MS - PULL_MS)) / PULL_MS) : 0;
          // Scroll to where the card's pull is p of the way through.
          scroller.scrollTop = (k + (p > 0 ? 0.12 + 0.76 * p : 0)) * scroller.clientHeight;
          frame();
        }
      }
      drawLoops(ms);
    },
  );
</script>
